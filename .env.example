DATABASE_URL=postgresql+asyncpg://aivoiceagent:aivoiceagent@localhost:5432/aivoiceagent
DATABASE_URL_SYNC=postgresql+psycopg2://aivoiceagent:aivoiceagent@localhost:5432/aivoiceagent
REDIS_URL=redis://localhost:6379/0
ENV=local
LOG_LEVEL=INFO
JWT_SECRET=

# LLM
LLM_PROVIDER=cerebras
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_ORDER=cerebras,openai,groq
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=4

OPENAI_API_KEY=
OPENAI_MODEL_MAIN=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini


GROQ_API_KEY=
GROQ_MODEL_MAIN=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

CEREBRAS_API_KEY=
CEREBRAS_MODEL_MAIN=gpt-oss-120b
CEREBRAS_MODEL_FAST=gpt-oss-120b

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# R5.08 chunk metadata (price / rate / area / BHK facts). off | boost | filter
# off = ignore tags (pre-R5.08 ranking), boost = lift matching chunks (default),
# filter = boost + restrict the vector arm to matching chunks (falls back when under-filled).
# Tag existing chunks once: python scripts/backfill_chunk_metadata.py --apply
RETRIEVAL_METADATA_MODE=boost
# R5.02 pgvector HNSW scan tuning (defaults shown; see core/app/engine/rag/vector_index.py)
RETRIEVAL_HNSW_TUNING_ENABLED=true
RETRIEVAL_HNSW_EF_SEARCH=100
RETRIEVAL_HNSW_ITERATIVE_SCAN=relaxed_order
RETRIEVAL_HNSW_MAX_SCAN_TUPLES=20000
RETRIEVAL_VECTOR_FORCE_CUSTOM_PLAN=true
RETRIEVAL_VECTOR_UNDERFILL_CHECK=true
# Debug only: logs EXPLAIN ANALYZE of every vector query (runs it twice)
RETRIEVAL_VECTOR_EXPLAIN=false
# Migration 0015: auto | plan_only (log the index rebuild SQL instead of running it)
VECTOR_INDEX_MIGRATION=auto

# Extracted-text normalisation before chunking (core/app/engine/rag/normalize.py):
# auto (no-op on clean markdown; unwraps lines only when the text looks extracted) | always | off
INGEST_NORMALIZE_MODE=auto

# R5.03 parent-child ("small-to-big") chunking (see core/app/engine/rag/parent_child.py)
# Per-tenant overrides in tenant.settings JSON: "chunk_parent_child_enabled": true|false and
# "retrieval_granularity": "flat"|"parent_child" (tenant setting wins over these globals).
# ENABLED in this example. Ingestion also stores ~200-char children under each chunk. Existing
# data: run core/scripts/backfill_parent_child.py (dry run by default; --apply to write), or
# retrieval simply finds no children and behaves like flat until it is run.
CHUNK_PARENT_CHILD_ENABLED=true
CHUNK_CHILD_TARGET_CHARS=200
CHUNK_CHILD_OVERLAP_CHARS=100
CHUNK_CHILD_LIST_GROUP_SIZE=3
CHUNK_CHILD_MIN_CHARS=40
CHUNK_CHILD_SPLIT_MIN_CHARS=200
CHUNK_CHILD_TITLE_PREFIX=false
CHUNK_CHILD_RECORD_SPLIT=false
# Retrieval: flat (pre-R5.03) | parent_child (search children + parents, return parents). A pure
# query-time switch over the same data — set to flat to roll back instantly. (The code default
# is flat; on the DSR KB parent_child measured a small ranking gain, not significant.)
RETRIEVAL_GRANULARITY=parent_child
# parent_child tuning (defaults = measured best on the DSR KB; see docs/r5.03-*.md section 6)
RETRIEVAL_PC_VECTOR_SCOPE=separate
RETRIEVAL_PC_TEXT_SCOPE=both
RETRIEVAL_PC_FUSION=parent_rank
RETRIEVAL_PC_PARENT_VECTOR_WEIGHT=1.0
RETRIEVAL_PARENT_SIBLING_WEIGHT=0.0
RETRIEVAL_PARENT_SIBLING_CAP=0.25
RETRIEVAL_PARENT_CHILD_POOL_FACTOR=2

BOOKING_TASK_MACHINE=true

OUTBOUND_IGNORE_CALLING_HOURS=true
OUTBOUND_IGNORE_FREQUENCY_CAPS=true

# Voice
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

SMART_TURN_ENABLED=true

# Loop monitor
LOOP_MONITOR_ENABLED=true
LOOP_MONITOR_DEEP=false
LOOP_MONITOR_SLOW_CALLBACK_MS=50

FILLER_AUDIO_CACHE_ENABLED=true

# Semantic endpointing
SEMANTIC_ENDPOINTING_ENABLED=true
ENDPOINTING_TRACE_ENABLED=true
SEMANTIC_ENDPOINTING_MS=200
SEMANTIC_REQUIRE_INCOMPLETE_CORROBORATION=true
SEMANTIC_CONTINUATION_GRACE_MS=1500
SEMANTIC_CONTINUATION_MAX_HOLD_MS=4000

# Parallel preconditions
PARALLEL_PRECONDITIONS_ENABLED=true
PARALLEL_PRECONDITIONS_TRACE=true

# Custom Instructions
# openai | openrouter | groq | mock
CI_LLM_PROVIDER=openai
CI_LLM_API_KEY=
CI_LLM_BASE_URL=
CI_COMPILE_MODEL=gpt-4o-mini
CI_COMPILE_MAX_TOKENS=3000

# Latency cut in the LLM call of understanding and propose
STREAM_RESPOND_NO_TOOL_ENABLED=true
UNDERSTANDING_CONCURRENT_WITH_PROPOSE=true

# Consent gate (app/engine/planner/consent.py). The semantic layer reads the caller's reply
# to "Shall I book …?" on the understanding call already made; false = deterministic only.
CONSENT_SEMANTIC_ENABLED=true
CONSENT_MAX_REASKS=2


# R5.01 rerank encoder
RETRIEVAL_RERANK_ENABLED=true
RETRIEVAL_MAX_CHUNKS_PER_DOC=3
RETRIEVAL_RERANK_CANDIDATES=10

# ── GTM demo links (docs/gtm-demo-links.md §13) ─────────────────────────────
# Off by default. With DEMO_ENABLED=true the app refuses to start on a missing or
# contradictory combination below (app/demo/settings.py).
DEMO_ENABLED=false
DEMO_TENANT_SLUG_PREFIX=demo-
# Our own staff tenant id(s); only their admins may use /admin/demo
DEMO_ADMIN_TENANT_IDS=

# Domain / URLs. The demo page is served by the UI service (Generic-voice-agent-UI, /t/<token>),
# so DEMO_PUBLIC_BASE_URL is that service's public URL (or a custom domain pointed at it).
# DEMO_ALLOWED_ORIGINS must include its origin (CORS + WebSocket Origin check).
DEMO_PUBLIC_BASE_URL=https://demo.phonn.ai
DEMO_ALLOWED_ORIGINS=https://demo.phonn.ai
DASHBOARD_URL=https://app.phonn.ai
# Dashboard origins allowed by CORS (comma-separated). Demo origins are added automatically
# when DEMO_ENABLED=true. Code default: the Railway UI URL + localhost:5173/3000.
ALLOWED_ORIGINS=https://ai-voice-agent-ui-production.up.railway.app,http://localhost:5173,http://localhost:3000

# Link lifetime
DEMO_LINK_TTL_DAYS=7
DEMO_DEFAULT_TIMEZONE=Asia/Kolkata

# Company links: one link per company, each person gets their own code (?r=…) in their copy.
# Fernet key(s) that encrypt link tokens so links can be exported again; required when
# DEMO_ENABLED=true. Comma-separated, first one encrypts (put a new key first to rotate).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEMO_LINK_TOKEN_KEYS=
DEMO_UTM_ENABLED=true
DEMO_UTM_SOURCE=email
DEMO_UTM_MEDIUM=cold_email
DEMO_UTM_CAMPAIGN=                        # empty = batch name, else demo_<industry>
DEMO_EXPORT_STEPS=e1,e2,e3,e4,li          # one URL column per email step (li = LinkedIn note)
DEMO_IDENTIFY_PROMPT=unknown_only         # off | unknown_only | always

# Call limits
DEMO_MAX_CALL_SECONDS=300
DEMO_MAX_CALLS_PER_LINK_PER_DAY=10
DEMO_MAX_CONCURRENT_CALLS_PER_LINK=1
DEMO_MAX_MINUTES_PER_LINK=60
DEMO_MAX_CONCURRENT_CALLS_GLOBAL=20

# Spend (0 = no cap)
DEMO_DAILY_BUDGET_USD=25
DEMO_BUDGET_ALERT_PCT=80
DEMO_BUDGET_TIMEZONE=Asia/Kolkata

# Abuse protection
DEMO_RATE_LIMIT_PER_MIN=30
DEMO_SESSIONS_PER_IP_PER_HOUR=5
# Turnstile is required outside ENV=local (the API refuses to boot without it). The demo
# page needs the matching VITE_TURNSTILE_SITE_KEY. Local test pair: secret
# 1x0000000000000000000000000000000AA with site key 1x00000000000000000000AA.
DEMO_TURNSTILE_ENABLED=false
# Set false to run outside ENV=local WITHOUT the bot check (logged as a warning at boot);
# then leave VITE_TURNSTILE_SITE_KEY unset on the UI. Only the rate/call/budget limits remain.
DEMO_TURNSTILE_REQUIRED=true
DEMO_TURNSTILE_SECRET=
DEMO_IP_HASH_SECRET=
# Where the caller's IP comes from (per-IP limits). x-forwarded-for + the number of proxies
# in front of the API: Railway alone = 1, Cloudflare in front of Railway = 2. Or a
# single-value edge header (cf-connecting-ip) when the origin is reachable only via that edge.
DEMO_CLIENT_IP_HEADER=x-forwarded-for
DEMO_TRUSTED_PROXY_HOPS=1

# Uploads
DEMO_UPLOAD_MAX_FILE_MB=20
DEMO_UPLOAD_MAX_FILES_PER_PROSPECT=50

# Lead email: smtp | sendgrid | resend | none
DEMO_EMAIL_PROVIDER=smtp
DEMO_LEAD_NOTIFY_EMAILS=
DEMO_ALERT_EMAILS=
DEMO_LEAD_FROM_EMAIL=
DEMO_LEAD_FROM_NAME=Phonn Demo Leads
DEMO_LEAD_EMAIL_SUBJECT_PREFIX=[Demo lead]
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
DEMO_EMAIL_API_KEY=
DEMO_NOTIFY_RETRY_MINUTES=5
DEMO_NOTIFY_MAX_ATTEMPTS=5

# Leads Google Sheet (empty id = sheet off)
DEMO_LEADS_GSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
DEMO_SHEET_LEADS_TAB=Leads
DEMO_SHEET_ACTIVITY_TAB=Demo activity
DEMO_SHEET_SYNC_MINUTES=5
DEMO_SHEET_AUTO_CREATE_TABS=true
DEMO_LEAD_STATUSES=New,Contacted,No answer,Follow up,Converted,Not interested

# Industries / tracking / retention
DEMO_INDUSTRIES_SEED_DIR=app/demo/industries/seed
# Workbook import: a column the industry doesn't know yet is offered as a new fact
# (propose) or skipped (ignore). Bookkeeping columns that never become facts:
DEMO_IMPORT_NEW_COLUMNS=propose
DEMO_IMPORT_IGNORE_COLUMNS=#,Minimum met?
DEMO_WEBHOOK_URL=
DEMO_TRANSCRIPT_RETENTION_DAYS=90

# ── Migrations: database stamped with a revision this code has no script for ─────────
# error (default): stop as before. skip: start without migrating (also right for a rollback).
# rebase: a migration from another branch (e.g. 0037 from R5.04) — treat it as the nearest
# known revision below it and apply what this code has after that. Local/dev use; never
# rewinds a database that is ahead of the code. See core/migrations/env.py.
ALEMBIC_UNKNOWN_REVISION=error
